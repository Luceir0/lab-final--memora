{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["content-island-snapshot.json"],
  "globalEnv": [
    "CONTENT_ISLAND_SNAPSHOT_PATH",
    "DATABASE_URL",
    "NODE_ENV",
    "APP_URL",
    "API_PORT",
    "COOKIE_DOMAIN",
    "SESSION_SECRET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "EMAIL_PROVIDER",
    "EMAIL_FROM",
    "RESEND_API_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "GEOCODING_PROVIDER",
    "GEOCODING_BASE_URL",
    "GEOCODING_USER_AGENT",
    "CONTENT_ISLAND_ACCESS_TOKEN",
    "CONTENT_ISLAND_PROJECT_ID",
    "VITE_API_BASE_URL",
    "API_INTERNAL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".tanstack/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}

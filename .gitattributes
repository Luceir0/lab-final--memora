# Finales de línea: LF en el repositorio. El working tree en Windows puede quedar
# en CRLF por core.autocrlf; Prettier usa endOfLine "auto" para aceptarlo.
* text=auto eol=lf

# Batch de Windows: cmd.exe necesita CRLF para las etiquetas y los saltos.
*.bat text eol=crlf

# Binarios: no normalizar
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

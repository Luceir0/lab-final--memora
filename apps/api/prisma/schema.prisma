// Memora data model.
//
// Source of truth: docs/03-architecture/data-model.md
// All timestamps use timestamptz(3); GPS coordinates are never persisted.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ThemePreference {
  light
  dark
  system
}

enum Role {
  owner
  member
}

enum DownloadKind {
  album
  selection
}

enum DownloadStatus {
  pending
  processing
  ready
  error
  expired
}

enum ActivityType {
  photo_uploaded @map("photo.uploaded")
  album_created  @map("album.created")
  member_joined  @map("member.joined")
}

model User {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  passwordHash     String
  avatarUrl        String?
  themePreference  ThemePreference @default(system)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  sessions           Session[]
  memberships        Membership[]
  ownedCircles       Circle[]        @relation("CircleOwner")
  createdInvitations Invitation[]    @relation("InvitationCreator")
  acceptedInvitations Invitation[]   @relation("InvitationAcceptor")
  createdAlbums      Album[]         @relation("AlbumCreator")
  uploadedPhotos     Photo[]         @relation("PhotoUploader")
  tagsReceived       PhotoTag[]      @relation("PhotoTagTaggedUser")
  tagsCreated        PhotoTag[]      @relation("PhotoTagCreator")
  downloadJobs       DownloadJob[]
  activities         Activity[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  lastUsedAt DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Circle {
  id           String   @id @default(cuid())
  ownerId      String
  name         String
  description  String?
  coverPhotoId String?
  settings     Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  owner       User          @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  coverPhoto  Photo?        @relation("CircleCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  memberships Membership[]
  invitations Invitation[]
  albums      Album[]
  photos      Photo[]
  downloadJobs DownloadJob[]
  activities  Activity[]
}

model Membership {
  id       String   @id @default(cuid())
  circleId String
  userId   String
  role     Role
  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
}

model Invitation {
  id           String    @id @default(cuid())
  circleId     String
  tokenHash    String    @unique
  createdBy    String
  invitedEmail String?
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  acceptedAt   DateTime? @db.Timestamptz(3)
  acceptedBy   String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  circle     Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  creator    User   @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  acceptor   User?  @relation("InvitationAcceptor", fields: [acceptedBy], references: [id], onDelete: SetNull)

  @@index([circleId, createdAt])
  @@index([expiresAt])
}

model Album {
  id           String    @id @default(cuid())
  circleId     String
  title        String
  description  String?
  date         DateTime? @db.Timestamptz(3)
  coverPhotoId String?
  createdBy    String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  circle     Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  coverPhoto Photo? @relation("AlbumCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  creator    User   @relation("AlbumCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  photos     Photo[]
  downloadJobs DownloadJob[]
  activities Activity[]

  @@index([circleId, createdAt])
}

model Photo {
  id             String    @id @default(cuid())
  circleId       String
  albumId        String
  uploaderId     String
  clientUploadId String?
  originalKey    String
  displayKey     String
  thumbKey       String
  mimeType       String
  size           Int
  width          Int
  height         Int
  takenAt        DateTime? @db.Timestamptz(3)
  placeName      String?
  description    String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploader User   @relation("PhotoUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  tags     PhotoTag[]
  activities Activity[]
  circleCovers Circle[] @relation("CircleCoverPhoto")
  albumCovers  Album[]  @relation("AlbumCoverPhoto")

  @@unique([uploaderId, clientUploadId])
  @@index([albumId, createdAt])
  @@index([circleId])
  @@index([uploaderId])
}

model PhotoTag {
  id           String   @id @default(cuid())
  photoId      String
  taggedUserId String
  createdBy    String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  photo      Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  taggedUser User  @relation("PhotoTagTaggedUser", fields: [taggedUserId], references: [id], onDelete: Cascade)
  creator    User  @relation("PhotoTagCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([photoId, taggedUserId])
  @@index([taggedUserId, photoId])
}

model DownloadJob {
  id           String         @id @default(cuid())
  circleId     String
  albumId      String?
  requestedBy  String
  kind         DownloadKind
  photoIds     Json?
  status       DownloadStatus @default(pending)
  objectKey    String?
  errorMessage String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime       @db.Timestamptz(3)
  completedAt  DateTime?      @db.Timestamptz(3)

  circle      Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  album       Album? @relation(fields: [albumId], references: [id], onDelete: SetNull)
  requester   User   @relation(fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([requestedBy, createdAt])
  @@index([expiresAt])
}

model Activity {
  id        String       @id @default(cuid())
  circleId  String
  actorId   String
  type      ActivityType
  albumId   String?
  photoId   String?
  metadata  Json?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  album  Album? @relation(fields: [albumId], references: [id], onDelete: SetNull)
  photo  Photo? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([circleId, createdAt])
  @@index([actorId, createdAt])
}

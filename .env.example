# Memora — variables de entorno de ejemplo.
#
# Copia este archivo a `.env` y rellena los secretos. `.env` nunca se versiona.
# Los valores de este archivo son los de la infraestructura local (docker compose).
# Documentación: docs/08-delivery/deployment.md y docs/03-architecture/external-services.md

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NODE_ENV=development
# Origen público de la web; se usa en enlaces de invitación y Open Graph.
APP_URL=http://localhost:3000
# Puerto de la API Fastify.
API_PORT=3001
# Dominio común de web y API para la cookie de sesión.
COOKIE_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Web (TanStack Start)
# ---------------------------------------------------------------------------
# Vite no lee este archivo desde la raíz. Define estas dos variables en el
# entorno o en `apps/web/.env`; aquí quedan como referencia de sus defaults.
# Base pública de la API para el navegador. Sin secreto.
# Por defecto /api, que usa el proxy de Vite en desarrollo.
VITE_API_BASE_URL=/api
# URL interna de la API para SSR y server functions.
# Es un origen absoluto, sin /api: el cliente de servidor añade la base.
# También es el destino del proxy /api de vite.config.ts.
API_INTERNAL_URL=http://127.0.0.1:3001

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------------
# Coincide con los defaults de docker-compose.yml (usuario/contraseña/base "memora").
DATABASE_URL=postgresql://memora:memora@localhost:5432/memora?schema=public

# ---------------------------------------------------------------------------
# Sesiones
# ---------------------------------------------------------------------------
# Secreto de firma de la cookie de sesión. Vacío a propósito: genéralo en local con
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# y nunca lo commitees. En producción, gestor de secretos del proveedor.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Almacenamiento S3 (Silo local, fork de MinIO; R2 o AWS S3 en producción)
# ---------------------------------------------------------------------------
# Endpoint accesible desde el servidor. Silo local por defecto (consola en :9001).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Bucket privado de fotos. Créalo antes de arrancar la API (no se autogenera aquí).
S3_BUCKET=memora
# Credenciales locales de Silo/MinIO (coinciden con los defaults de docker-compose.yml).
S3_ACCESS_KEY_ID=memora
S3_SECRET_ACCESS_KEY=memora123
# Silo/MinIO requiere path-style; R2/S3 también lo aceptan.
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Email (Mailpit local; Resend opcional en producción)
# ---------------------------------------------------------------------------
# Valores admitidos: mailpit | resend
EMAIL_PROVIDER=mailpit
# Remitente de las invitaciones. En local cualquier dirección es válida.
EMAIL_FROM=Memora <no-reply@memora.local>
# Solo para EMAIL_PROVIDER=resend. Nunca en cliente.
RESEND_API_KEY=
# Servidor SMTP de Mailpit en local (contenedor, puerto 1025).
SMTP_HOST=localhost
SMTP_PORT=1025

# ---------------------------------------------------------------------------
# Geocodificación (Nominatim / OpenStreetMap)
# ---------------------------------------------------------------------------
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim exige un User-Agent identificativo con contacto.
GEOCODING_USER_AGENT=Memora-local/0.1 (dev@memora.local)

# ---------------------------------------------------------------------------
# Content Island (Ayuda, FAQ y Privacidad, solo en build)
# ---------------------------------------------------------------------------
# Token de lectura. Vacío a propósito: pídelo al proyecto de Content Island.
CONTENT_ISLAND_ACCESS_TOKEN=
# Opcional, solo si el proyecto de Content Island lo requiere.
CONTENT_ISLAND_PROJECT_ID=

# ---------------------------------------------------------------------------
# Infraestructura local (solo docker compose, no las lee la aplicación)
# ---------------------------------------------------------------------------
# Cambiarlas exige actualizar DATABASE_URL / S3_* en consecuencia.
POSTGRES_USER=memora
POSTGRES_PASSWORD=memora
POSTGRES_DB=memora
POSTGRES_PORT=5432
# Silo/MinIO exige una contraseña de 8 caracteres o más.
MINIO_ROOT_USER=memora
MINIO_ROOT_PASSWORD=memora123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
